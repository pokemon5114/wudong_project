# 服务端口
PORT=8001

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=wudong_platform

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# auto 会在启动时探测 Redis；不可用时自动关闭并回退数据库。
# Redis 启动后可改为 true 以启用缓存。
REDIS_ENABLED=auto
REDIS_KEY_PREFIX=wudong:

# JWT密钥（请修改为随机字符串）
JWT_SECRET=wudong-platform-secret-2026

# 前端API地址
API_BASE_URL=http://localhost:8001
